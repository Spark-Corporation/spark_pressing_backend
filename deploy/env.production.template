APP_NAME="Spark Pressing API"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=__APP_URL__
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=/home/sparqrqm/public_html/pressing-api/database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="pressing-api@pressingelegance.com"
MAIL_FROM_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=__CORS_ALLOWED_ORIGINS__
CORS_SUPPORTS_CREDENTIALS=false

SPARK_FORCE_HTTPS=false
SPARK_REFERRAL_BONUS=0
SPARK_ENFORCE_LICENSES=false
