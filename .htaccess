# Document root cPanel = /home/sparqrqm/public_html/pressing-api
# Les requêtes web doivent entrer par public/ (Laravel).
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|vendor|tests)(?:/|$) - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
